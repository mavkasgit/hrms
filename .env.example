# HRMS environment reference
#
# Copy the relevant section into .env.dev, .env.test, or .env.prod.
# Real .env.* files are ignored by git.
#
# Architecture:
# - prod: nginx on 80/443
# - test: nginx on 8080
# - dev: run Vite directly (no nginx required)
#
# Inside Docker, all services use standard ports:
# - frontend:  3000
# - backend:   8000
# - postgres:  5432
# - onlyoffice: 80
#
# URL roles:
# - BASE_URL / PUBLIC_URL: browser/public URL (what users open)
# - ONLYOFFICE_PUBLIC_URL: browser URL for Document Server (usually BASE_URL + /onlyoffice)
# - BACKEND_INTERNAL_CALLBACK_URL: internal URL ONLYOFFICE uses for callbacks/file download
# - APP_PUBLIC_URL: legacy fallback for callback URL (kept for backward compatibility)

# -----------------------------------------------------------------------------
# OIDC / Authentik (A3 bridge) — dual-run with local password/TG login
# Full design: ../authentik/BLUEPRINT.md (VibeCoding/authentik)
# -----------------------------------------------------------------------------
# AUTH_OIDC_ENABLED — false = local login only; true = show IdP + accept OIDC callback
# AUTH_OIDC_ISSUER — per-app issuer (…/application/o/hrms/)
# AUTH_OIDC_CLIENT_ID — public SPA client id (slug hrms)
# AUTH_OIDC_CLIENT_SECRET — empty for public+PKCE; set only for confidential BFF
# AUTH_OIDC_REDIRECT_URI — exact match provider allow-list (FE /auth/callback)
# AUTH_OIDC_SCOPES — must include openid + custom hrms_access for claim mapping
# AUTH_OIDC_ALLOW_JIT — if true, auto-create User on first OIDC login (default false, like TELEGRAM_ALLOW_JIT)
# AUTH_OIDC_DEFAULT_ROLE — role for JIT users (admin|viewer)
# AUTH_OIDC_TELEGRAM_PRIMARY — TG1: FE «Войти через Telegram» SSO CTA; hide in-app bot login on LoginPage
# Optional: AUTH_OIDC_AUTHORIZATION_URL / TOKEN_URL / JWKS_URL / END_SESSION_URL
#           (if empty, A3 derives endpoints from issuer path)
# Frontend (Vite): VITE_SSO_STUB=false — always show full login form even when OIDC enabled.
#   Default (absent): /login is SSO stub → auto redirect to Authentik; escape: /login?password=1
# Telegram IdP setup: ../authentik/TELEGRAM.md (VibeCoding/authentik)

AUTH_OIDC_ENABLED=false
AUTH_OIDC_ISSUER=http://localhost:9000/application/o/hrms/
AUTH_OIDC_CLIENT_ID=hrms
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
AUTH_OIDC_SCOPES=openid profile email hrms_access
AUTH_OIDC_ALLOW_JIT=false
AUTH_OIDC_DEFAULT_ROLE=viewer
AUTH_OIDC_TELEGRAM_PRIMARY=false

# Authentik Admin API proxy (SSO-D) — manage hrms-admin / hrms-viewer from HRMS UI
# Token stays on backend only (never VITE_* / frontend). Empty token = deep-link fallback only.
# AUTHENTIK_API_URL — base of Authentik (no /api/v3 suffix; code joins it)
# AUTHENTIK_API_TOKEN — Directory → Tokens and App passwords (admin); do NOT commit real value
# AUTHENTIK_PUBLIC_URL — public origin for deep-links (/if/user/, /if/admin/); defaults to API URL
AUTHENTIK_API_URL=http://localhost:9000
AUTHENTIK_API_TOKEN=
AUTHENTIK_PUBLIC_URL=http://localhost:9000

# -----------------------------------------------------------------------------
# Telegram Login (bot deep-link + Widget) — shared across envs; override per .env.*
# -----------------------------------------------------------------------------
# TELEGRAM_BOT_USERNAME — bot username without @ (deep links / button)
# TELEGRAM_ALLOW_JIT — if true, auto-create User on first TG login
# TELEGRAM_DEFAULT_ROLE — role for JIT users (admin|viewer)
# TELEGRAM_BOT_CHALLENGE_TTL_SECONDS — bot deep-link challenge TTL
# TELEGRAM_AUTH_DATE_MAX_AGE_SECONDS — max age for legacy widget auth_date
# TELEGRAM_WEBHOOK_SECRET — X-Telegram-Bot-Api-Secret-Token expected value
# TELEGRAM_RATE_LIMIT_REQUESTS / TELEGRAM_RATE_LIMIT_WINDOW_SECONDS — public TG endpoints
# Note: TELEGRAM_BOT_TOKEN is set at runtime via /settings/users UI
#       (table system_settings, key telegram.bot_token). No env fallback in dev.
# TELEGRAM_ALLOWED_ORIGINS — unused reserved (origin check not implemented without FE widget)

TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOW_JIT=false
TELEGRAM_DEFAULT_ROLE=viewer
TELEGRAM_BOT_CHALLENGE_TTL_SECONDS=300
TELEGRAM_AUTH_DATE_MAX_AGE_SECONDS=86400
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_RATE_LIMIT_REQUESTS=30
TELEGRAM_RATE_LIMIT_WINDOW_SECONDS=60
# Dev: true = backend pulls Telegram updates (getUpdates), real /start in TG app, no ngrok
TELEGRAM_UPDATES_POLLING=true

# -----------------------------------------------------------------------------
# .env.dev  (backend/frontend local, postgres+onlyoffice in Docker)
# -----------------------------------------------------------------------------

ENV=dev
BASE_URL=http://localhost:5173
PUBLIC_URL=http://localhost:5173
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql+asyncpg://hrms_user:hrms_pass@localhost:5432/hrms_dev
ONLYOFFICE_ENABLED=true
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_PUBLIC_URL=http://localhost:8085
ONLYOFFICE_INTERNAL_URL=http://localhost:8085
BACKEND_INTERNAL_CALLBACK_URL=http://host.docker.internal:8000
APP_PUBLIC_URL=http://host.docker.internal:8000
TZ=Europe/Moscow

# -----------------------------------------------------------------------------
# .env.test  (nginx port 8080)
# -----------------------------------------------------------------------------

ENV=test
BASE_URL=http://192.168.100.200:8080
PUBLIC_URL=http://192.168.100.200:8080
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
ONLYOFFICE_ENABLED=true
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_PUBLIC_URL=${PUBLIC_URL}/onlyoffice
ONLYOFFICE_INTERNAL_URL=http://nginx/onlyoffice
BACKEND_INTERNAL_CALLBACK_URL=http://backend:8000
APP_PUBLIC_URL=http://backend:8000
LOCALTUNNEL_SUBDOMAIN=
TZ=Europe/Moscow

# -----------------------------------------------------------------------------
# .env.prod  (nginx port 80)
# -----------------------------------------------------------------------------

ENV=prod
BASE_URL=http://192.168.100.200
PUBLIC_URL=http://192.168.100.200
SECRET_KEY=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
ONLYOFFICE_ENABLED=true
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_PUBLIC_URL=${PUBLIC_URL}/onlyoffice
ONLYOFFICE_INTERNAL_URL=http://nginx/onlyoffice
BACKEND_INTERNAL_CALLBACK_URL=http://backend:8000
APP_PUBLIC_URL=${PUBLIC_URL}
TELEGRAM_PUBLIC_APP_URL=${PUBLIC_URL}
PROD_POSTGRES_DATA_PATH=
LOCALTUNNEL_SUBDOMAIN=
TZ=Europe/Moscow
