# HRMS environment reference
#
# Copy the relevant section into .env.dev, .env.test, or .env.prod.
# Real .env.* files are ignored by git.
#
# Architecture:
# - prod: nginx on 80/443
# - test: nginx on 8080
# - dev: run Vite directly (no nginx required)
#
# Inside Docker, all services use standard ports:
# - frontend:  3000
# - backend:   8000
# - postgres:  5432
# - onlyoffice: 80
#
# URL roles:
# - BASE_URL / PUBLIC_URL: browser/public URL (what users open)
# - ONLYOFFICE_PUBLIC_URL: browser URL for Document Server (usually BASE_URL + /onlyoffice)
# - BACKEND_INTERNAL_CALLBACK_URL: internal URL ONLYOFFICE uses for callbacks/file download
# - APP_PUBLIC_URL: legacy fallback for callback URL (kept for backward compatibility)

# -----------------------------------------------------------------------------
# OIDC / Authentik (SSO bridge) — единственный пользовательский путь входа
# (аварийный вход — Break Glass ниже). Локальные пароли/invite удалены (#36).
# Full design: ../authentik/BLUEPRINT.md (VibeCoding/authentik)
# -----------------------------------------------------------------------------
# AUTH_OIDC_ENABLED — true = show IdP + accept OIDC callback; false = только break-glass
# AUTH_OIDC_ISSUER — per-app issuer (…/application/o/hrms/)
# AUTH_OIDC_CLIENT_ID — public SPA client id (slug hrms)
# AUTH_OIDC_CLIENT_SECRET — empty for public+PKCE; set only for confidential BFF
# AUTH_OIDC_REDIRECT_URI — exact match provider allow-list (FE /auth/callback)
# AUTH_OIDC_SCOPES — must include openid + custom hrms_access for claim mapping
# AUTH_OIDC_ALLOW_JIT — if true, auto-create User on first OIDC login (default false)
# Invite: ../authentik/INVITE.md (onboarding через IdP, не через HRMS)
# Optional: AUTH_OIDC_AUTHORIZATION_URL / TOKEN_URL / JWKS_URL / END_SESSION_URL
#           (if empty, A3 derives endpoints from issuer path)
# Frontend: /login — SSO CTA + break-glass форма; при reachable IdP auto-redirect в Authentik.

# -----------------------------------------------------------------------------
# App JWT secrets — MUST be per-app (hrms-specific). Never share with KTM-2000
# or any other app. Cross-app SSO is Authentik OIDC only (not shared HS256).
# JWT_SECRET_KEY preferred; falls back to SECRET_KEY if unset.
# -----------------------------------------------------------------------------
SECRET_KEY=
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Dev/test only: magic Bearer "admin" token.
# Must be false in production (strict JWT; no magic token).
DEV_BYPASS_AUTH=false

# Emergency Break Glass access (isolated admin login via POST /api/auth/break-glass/login).
# Проверка пароля — по env-конфигу (вне БД): BREAK_GLASS_PASSWORD (открытый)
# либо BREAK_GLASS_PASSWORD_HASH (bcrypt); при заданном PASSWORD приоритет у него.
BREAK_GLASS_ENABLED=false
BREAK_GLASS_USER=emergency_admin
BREAK_GLASS_PASSWORD=
BREAK_GLASS_PASSWORD_HASH=

AUTH_OIDC_ENABLED=false
# Prefer host LAN IP for multi-device; SPA rewrites IdP host to page host when needed
AUTH_OIDC_ISSUER=http://${OPS_PUBLIC_IP}:9000/application/o/hrms/
AUTH_OIDC_CLIENT_ID=hrms
AUTH_OIDC_CLIENT_SECRET=
# Hint only — FE uses window.location.origin (dev :5171 / prod nginx :8081)
AUTH_OIDC_REDIRECT_URI=http://localhost:5171/auth/callback
AUTH_OIDC_SCOPES=openid profile email hrms_access
# Extra hosts accepted in id_token.iss (comma-separated)
AUTH_OIDC_ISSUER_ALIASES=${OPS_PUBLIC_IP},localhost,127.0.0.1,host.docker.internal
# JIT-создание локального User при первом OIDC-входе. false → 403
# oidc_user_not_linked, если нет привязки (authentik_sub / username / email).
AUTH_OIDC_ALLOW_JIT=false

# Авто-сид администратора при старте, если админов в системе нет.
# Созданный admin не имеет пароля/sub и активируется при OIDC-привязке
# с таким же username/email.
ADMIN_SEED_ENABLED=true
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_FULL_NAME=Администратор

# SSO-only флаг (информационный в /auth/oidc/config): парольные и invite-пути
# входа удалены (#36), вход пользователей — только Authentik SSO.
AUTH_SSO_ONLY=false
AUTH_OIDC_LOGIN_HINT_ENABLED=true

# Authentik Admin API proxy (SSO-D) — manage hrms-admin / hrms-viewer from HRMS UI
# Token stays on backend only (never VITE_* / frontend). Empty token = deep-link fallback only.
# AUTHENTIK_*_URL: absolute URL or "auto" (detect host LAN IP at runtime — app.core.host_net)
# Docker BE→IdP often needs: AUTHENTIK_API_URL=http://host.docker.internal:9000
# AUTHENTIK_API_TOKEN — Directory → Tokens (admin); do NOT commit real value
AUTHENTIK_API_URL=auto
AUTHENTIK_API_TOKEN=
AUTHENTIK_PUBLIC_URL=auto

# -----------------------------------------------------------------------------
# .env.dev  (backend/frontend local, postgres+onlyoffice in Docker)
# -----------------------------------------------------------------------------

ENV=dev
BASE_URL=http://localhost:5171
PUBLIC_URL=http://localhost:5171
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql+asyncpg://hrms_user:hrms_pass@localhost:5432/hrms_dev
ONLYOFFICE_ENABLED=true
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_PUBLIC_URL=http://localhost:8085
ONLYOFFICE_INTERNAL_URL=http://localhost:8085
BACKEND_INTERNAL_CALLBACK_URL=http://host.docker.internal:8000
APP_PUBLIC_URL=http://host.docker.internal:8000
TZ=Europe/Moscow

# -----------------------------------------------------------------------------
# .env.test  (nginx port 8080)
# -----------------------------------------------------------------------------

ENV=test
BASE_URL=http://${OPS_PUBLIC_IP}:8080
PUBLIC_URL=http://${OPS_PUBLIC_IP}:8080
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
ONLYOFFICE_ENABLED=true
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_PUBLIC_URL=${PUBLIC_URL}/onlyoffice
ONLYOFFICE_INTERNAL_URL=http://nginx/onlyoffice
BACKEND_INTERNAL_CALLBACK_URL=http://backend:8000
APP_PUBLIC_URL=http://backend:8000
LOCALTUNNEL_SUBDOMAIN=
TZ=Europe/Moscow

# -----------------------------------------------------------------------------
# .env.prod  (nginx port 80)
# -----------------------------------------------------------------------------

ENV=prod
BASE_URL=http://${OPS_PUBLIC_IP}
PUBLIC_URL=http://${OPS_PUBLIC_IP}
SECRET_KEY=
JWT_SECRET_KEY=
DEV_BYPASS_AUTH=false
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
ONLYOFFICE_ENABLED=true
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_PUBLIC_URL=${PUBLIC_URL}/onlyoffice
ONLYOFFICE_INTERNAL_URL=http://nginx/onlyoffice
BACKEND_INTERNAL_CALLBACK_URL=http://backend:8000
APP_PUBLIC_URL=${PUBLIC_URL}
PROD_POSTGRES_DATA_PATH=
LOCALTUNNEL_SUBDOMAIN=
TZ=Europe/Moscow
