# =============================================================================
# HRMS — эталонный пример переменных окружения
# =============================================================================
# Скопируй в .env / .env.dev / .env.test / .env.prod и заполни реальными
# значениями (секреты — сгенерируй на месте). Не коммить реальные .env*.
#
# Файлы, которые это читают:
#   - backend/app/core/config.py         (pydantic-settings, env_file по ENV_FILE)
#   - infra/compose/docker-compose.*.yml (подстановка ${VAR} + env_file: ../../.env.prod)
#   - frontend: VITE_API_URL / VITE_AUTH_MODE / VITE_KTM_PORT (Vite)
#
# Архитектура (порты):
#   prod: nginx → :8081   |  test: nginx → :8080  |  dev: Vite → :5171
# Внутри compose-сети: frontend :3000 · backend :8000 · postgres :5432 · onlyoffice :80
#
# URL-роли:
#   BASE_URL / PUBLIC_URL          — публичный URL (что открывает браузер)
#   ONLYOFFICE_PUBLIC_URL          — браузерный URL Document Server (обычно ${PUBLIC_URL}/onlyoffice)
#   BACKEND_INTERNAL_CALLBACK_URL  — внутренний URL для callback'ов OnlyOffice/файлов
#   APP_PUBLIC_URL                 — публичный URL (fallback для callback'ов)
# =============================================================================

# -----------------------------------------------------------------------------
# LAN-адрес хоста — ЕДИНЫЙ для всех трёх проектов (authentik/ktm2000/hrms).
# Подставляется в BASE_URL, OIDC-issuer, redirect, AUTHENTIK_*_URL.
# Узнать: ipconfig → IPv4 активного адаптера (не 127.0.0.1).
# -----------------------------------------------------------------------------
OPS_PUBLIC_IP=192.168.100.200

# Окружение: dev | test | prod.
ENV=prod

# -----------------------------------------------------------------------------
# Публичные URL
# -----------------------------------------------------------------------------
# Публичный URL (браузер). prod :8081, test :8080, dev :5171.
BASE_URL=http://${OPS_PUBLIC_IP}:8081
PUBLIC_URL=http://${OPS_PUBLIC_IP}:8081
# Публичный URL API/приложения (для абсолютных ссылок). "auto" — вывести из LAN IP.
APP_PUBLIC_URL=http://${OPS_PUBLIC_IP}:8081

# -----------------------------------------------------------------------------
# Секреты приложения (JWT)
# -----------------------------------------------------------------------------
# СЕКРЕТ. Fallback для JWT, если не задан JWT_SECRET_KEY. >40 символов.
SECRET_KEY=change-me-app-secret-key-min-40-chars
# СЕКРЕТ. Основной HS256-ключ. ОБЯЗАТЕЛЬНО свой для HRMS — НЕ делить с KTM
# (SSO — только через Authentik, не общий HS256).
JWT_SECRET_KEY=change-me-hrms-jwt-secret-key
# Время жизни access-токена, минуты.
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Алгоритм подписи JWT. Не менять без необходимости.
ALGORITHM=HS256
# Dev/test only: magic Bearer "admin"/"viewer". В prod ОБЯЗАТЕЛЬНО false.
DEV_BYPASS_AUTH=false
# Пул соединений с БД.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
# Таймаут SQL-запроса, секунды.
DB_QUERY_TIMEOUT=30
# Таймаут генерации документов, секунды.
DOCUMENT_GENERATION_TIMEOUT=60
# true = логировать все SQL-запросы (только для отладки).
SQL_ECHO=false

# -----------------------------------------------------------------------------
# Сервисный ключ (service-to-service, idp-ops → HRMS)
# -----------------------------------------------------------------------------
# СЕКРЕТ. Шлётся в заголовке X-Service-Key. ДОЛЖЕН СОВПАДАТЬ с
# OPS_HRMS_SERVICE_KEY в authentik/.env. Не истекает, без логина.
SERVICE_API_KEY=change-me-hrms-service-key

# -----------------------------------------------------------------------------
# Break Glass (аварийный вход, когда Authentik недоступен)
# -----------------------------------------------------------------------------
BREAK_GLASS_ENABLED=false
# Логин аварийного пользователя.
BREAK_GLASS_USER=emergency_admin
# ПАРОЛЬ — СЕКРЕТ. Приоритет у открытого пароля перед хэшем.
BREAK_GLASS_PASSWORD=change-me-break-glass-password
# Альтернатива: bcrypt-хэш (для реального прод).
BREAK_GLASS_PASSWORD_HASH=

# -----------------------------------------------------------------------------
# База данных (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=hrms_user
# ПАРОЛЬ БД — СЕКРЕТ. Совпадает с паролем в DATABASE_URL.
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=hrms_prod
# DSN для SQLAlchemy. Внутри compose-сети host = postgres, порт = 5432.
DATABASE_URL=postgresql+asyncpg://hrms_user:change-me-postgres-password@postgres:5432/hrms_prod
# Кастомный путь данных Postgres в prod (bind-mount; относительно infra/compose).
# Пусто → дефолт из compose (../../data/postgres).
PROD_POSTGRES_DATA_PATH=
# Имя контейнера Postgres — нужно скриптам бэкапов (docker exec).
POSTGRES_CONTAINER_NAME=hrms-postgres-prod
# Альтернативный DSN (используется в тестах/доп. подключениях).
DATABASE_URL_LOCAL=postgresql+asyncpg://hrms_user:change-me-postgres-password@localhost:5432/hrms_prod

# -----------------------------------------------------------------------------
# Пути хранения данных (bind-mount; prod монтирует их в compose)
# -----------------------------------------------------------------------------
ORDERS_PATH=/app/data/orders
TEMPLATES_PATH=/app/data/templates
STAFFING_PATH=/app/data/staffing
PERSONAL_FILES_PATH=/app/data/personal
NOTIFICATIONS_PATH=/app/data/notifications
STATEMENTS_PATH=/app/data/statements
TIMESHEET_SNAPSHOTS_PATH=/app/data/timesheet_snapshots
BACKUPS_PATH=/app/data/backups

# -----------------------------------------------------------------------------
# Лимиты файлов и логирование
# -----------------------------------------------------------------------------
# Макс. размер фото, байт (5 МБ).
MAX_PHOTO_SIZE=5242880
# Макс. размер документа, байт (10 МБ).
MAX_DOCUMENT_SIZE=10485760
# Суммарный лимит личных файлов, байт (50 МБ).
MAX_PERSONAL_FILES_TOTAL=52428800
# Уровень логирования: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# Файл лога (внутри контейнера). Ротация по размеру.
LOG_FILE=/app/logs/hrms.log
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# Сессии / аудит входов
# -----------------------------------------------------------------------------
# Сколько X-Forwarded-For снимать (за nginx/reverse-proxy). Для прямого доступа = 0.
TRUSTED_PROXY_COUNT=1
# Троттлинг обновления last_seen сессии, секунды.
SESSION_LAST_SEEN_THROTTLE_SECONDS=300
# Окно истории входов (дней) для /auth/me/login-events.
LOGIN_EVENTS_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# OnlyOffice Document Server (редактирование документов)
# -----------------------------------------------------------------------------
ONLYOFFICE_ENABLED=true
# СЕКРЕТ. JWT-секрет Document Server. Совпадает с JWT_SECRET в контейнере onlyoffice.
ONLYOFFICE_JWT_SECRET=change-me-onlyoffice-jwt-secret
# Браузерный URL Document Server (обычно ${PUBLIC_URL}/onlyoffice, проксируется nginx).
ONLYOFFICE_PUBLIC_URL=${PUBLIC_URL}/onlyoffice
# Внутренний URL Document Server из nginx (внутри compose-сети).
ONLYOFFICE_INTERNAL_URL=http://nginx/onlyoffice
# Внутренний URL бэкенда для callback'ов OnlyOffice.
BACKEND_INTERNAL_CALLBACK_URL=http://backend:8000

# -----------------------------------------------------------------------------
# LocalTunnel (профиль tunnel в compose) — публичный туннель наружу.
# -----------------------------------------------------------------------------
# Публичный поддомен localtunnel (например hrms-prod-7q2k9m4x).
LOCALTUNNEL_SUBDOMAIN=hrms-prod

# -----------------------------------------------------------------------------
# OIDC / Authentik bridge (SSO). Единственный пользовательский путь входа.
# false = вход только через Break Glass.
# -----------------------------------------------------------------------------
AUTH_OIDC_ENABLED=true
# Issuer — per-app: путь обязан заканчиваться слагом приложения.
# Формат: http://<OPS_PUBLIC_IP>:9000/application/o/<slug>/
AUTH_OIDC_ISSUER=http://${OPS_PUBLIC_IP}:9000/application/o/hrms/
# Публичный client id (= слаг приложения в Authentik).
AUTH_OIDC_CLIENT_ID=hrms
# Пусто для public+PKCE клиента.
AUTH_OIDC_CLIENT_SECRET=
# Redirect URI — exact match. Пусто/auto → config.py выведет из APP_PUBLIC_URL.
AUTH_OIDC_REDIRECT_URI=http://${OPS_PUBLIC_IP}:8081/auth/callback
# Скоупы: обязательны openid + кастомный hrms_access.
AUTH_OIDC_SCOPES=openid profile email hrms_access
# Доп. хосты в id_token.iss через запятую.
AUTH_OIDC_ISSUER_ALIASES=${OPS_PUBLIC_IP},localhost,127.0.0.1,host.docker.internal
# Опциональные переопределения URL (пусто → из issuer/discovery).
AUTH_OIDC_AUTHORIZATION_URL=
AUTH_OIDC_TOKEN_URL=
AUTH_OIDC_JWKS_URL=
AUTH_OIDC_END_SESSION_URL=
# true = создавать локального User при первом OIDC-входе (JIT). false → 403.
AUTH_OIDC_ALLOW_JIT=true
# Роль JIT-пользователя (admin|viewer|no_access).
AUTH_OIDC_DEFAULT_ROLE=viewer
# true = маппить IdP-группы → users.role при link/JIT.
AUTH_OIDC_SYNC_ROLE_FROM_IDP=false
# SSO-only режим: парольные и invite-пути входа удалены, вход — только Authentik SSO.
AUTH_SSO_ONLY=true
AUTH_OIDC_LOGIN_HINT_ENABLED=true

# -----------------------------------------------------------------------------
# Авто-сид администратора (на старте, если в системе нет админов)
# -----------------------------------------------------------------------------
# Созданный admin не имеет пароля/authentik_sub — активируется при OIDC-привязке
# с тем же username/email. Без этого OIDC-вход упадёт 403 oidc_user_not_linked.
ADMIN_SEED_ENABLED=true
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_FULL_NAME=Администратор

# -----------------------------------------------------------------------------
# Authentik Admin API (профиль/синхронизация). Токен — только на бэкенде.
# -----------------------------------------------------------------------------
# URL API: абсолютный или "auto". В Docker BE→IdP: http://host.docker.internal:9000.
AUTHENTIK_API_URL=auto
# СЕКРЕТ. Directory → Tokens (admin). Пусто = IdP admin proxy отключён.
AUTHENTIK_API_TOKEN=change-me-authentik-api-token
# Публичный URL Authentik.
AUTHENTIK_PUBLIC_URL=auto
# TTL кеша профиля пользователя (секунды).
AUTHENTIK_PROFILE_TTL_SECONDS=300

# -----------------------------------------------------------------------------
# Интеграция с KTM-2000 (синхронизация)
# -----------------------------------------------------------------------------
# Внутренний URL синхронизации KTM-2000 (внутри compose-сети).
KTM2000_SYNC_URL=http://backend:8000/api/integration/sync-employee
# СЕКРЕТ. Токен интеграции KTM-2000.
KTM2000_INTEGRATION_TOKEN=change-me-ktm-integration-token

# -----------------------------------------------------------------------------
# Прочее
# -----------------------------------------------------------------------------
# Часовой пояс (влияет на даты отчётов и OnlyOffice).
TZ=Europe/Moscow

# -----------------------------------------------------------------------------
# Dev/test-only compose-переменные (см. infra/compose/docker-compose.{dev,test,pytest}.yml)
# -----------------------------------------------------------------------------
# Порт Postgres в dev-compose.
DEV_POSTGRES_PORT=5441
# Путь данных Postgres в dev-compose.
DEV_POSTGRES_DATA_PATH=../../data/postgres-dev
# Порт OnlyOffice в dev-compose.
DEV_ONLYOFFICE_PORT=8085
# Порт Postgres в pytest-compose.
PYTEST_POSTGRES_PORT=5442

# -----------------------------------------------------------------------------
# Frontend (Vite; только dev-сборка)
# -----------------------------------------------------------------------------
# Базовый URL API для запросов из браузера. Пусто/нет → "/api" (тот же origin).
# VITE_API_URL=http://${OPS_PUBLIC_IP}:8081/api
# dev|test — включает dev-режим auth-оболочки (magic-токены). В prod НЕ задавать.
# VITE_AUTH_MODE=prod
# Порт KTM-2000 для SSO-перехода (dev; прод автоматически :8082).
# VITE_KTM_PORT=5180
