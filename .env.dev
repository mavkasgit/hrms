# Dev environment
# Backend/frontend run locally, only postgres + onlyoffice run in Docker
OPS_PUBLIC_IP=192.168.100.200

ENV=dev

# === BASE URL (frontend dev server) ===
BASE_URL=http://localhost:5171
PUBLIC_URL=http://localhost:5171

# === Database ===
POSTGRES_USER=hrms_user
POSTGRES_PASSWORD=hrms_pass
POSTGRES_DB=hrms_dev
DEV_POSTGRES_PORT=5435
DATABASE_URL=postgresql+asyncpg://hrms_user:hrms_pass@localhost:5435/hrms_dev

# === OnlyOffice ===
ONLYOFFICE_ENABLED=true
ONLYOFFICE_JWT_SECRET=onlyoffice-dev-secret-change-me
ONLYOFFICE_PUBLIC_URL=http://localhost:8085
ONLYOFFICE_INTERNAL_URL=http://localhost:8085

# === App ===
# URL that ONLYOFFICE container can reach to download/upload docs from backend
BACKEND_INTERNAL_CALLBACK_URL=http://host.docker.internal:8000
APP_PUBLIC_URL=http://host.docker.internal:8000

# Per-app JWT only — never share with KTM; SSO is Authentik
JWT_SECRET_KEY=hrms-jwt-dev-secret-change-me

# Emergency Break Glass Access
BREAK_GLASS_ENABLED=true
BREAK_GLASS_USER=emergency_admin
BREAK_GLASS_PASSWORD=dev

# === Frontend auth mode (dev/test enables bypass buttons) ===
VITE_AUTH_MODE=dev
TZ=Europe/Moscow


# OIDC / Authentik — allow-list in IdP has both :5171 (dev) and :8081 (prod)
AUTH_OIDC_ENABLED=true
# Prefer LAN IP so phone/other hosts can reach IdP; SPA maps host to page origin
AUTH_OIDC_ISSUER=http://${OPS_PUBLIC_IP}:9000/application/o/hrms/
AUTH_OIDC_CLIENT_ID=hrms
AUTH_OIDC_CLIENT_SECRET=
# Hint; SPA uses window.location.origin (typically http://localhost:5171/auth/callback)
AUTH_OIDC_REDIRECT_URI=http://localhost:5171/auth/callback
AUTH_OIDC_SCOPES=openid profile email hrms_access
AUTH_OIDC_ISSUER_ALIASES=localhost,127.0.0.1,host.docker.internal
AUTH_OIDC_ALLOW_JIT=false
AUTH_SSO_ONLY=false
AUTH_OIDC_LOGIN_HINT_ENABLED=true
AUTHENTIK_API_URL=http://${OPS_PUBLIC_IP}:9000
AUTHENTIK_API_TOKEN=ak-bootstrap-dev-token-local-not-prod
AUTHENTIK_PUBLIC_URL=http://${OPS_PUBLIC_IP}:9000
