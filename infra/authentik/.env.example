# Authentik — example env (copy to .env and fill secrets).
# Never commit a real .env with live secrets.

# --- Required secrets ---
# PostgreSQL password (max ~99 chars; Postgres limitation)
# Generate: openssl rand -base64 36
PG_PASS=change-me-strong-pg-password

# Cookie / session signing key (≥50 chars recommended; changing invalidates sessions)
# Generate: openssl rand -base64 60
AUTHENTIK_SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-50-chars

# --- PostgreSQL (optional overrides) ---
PG_USER=authentik
PG_DB=authentik

# --- Image pin (optional; defaults match docker-compose.yml) ---
# AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=2026.5.4

# --- Host ports (authentik listens on 9000 HTTP / 9443 HTTPS inside) ---
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443

# --- Optional: error reporting ---
# AUTHENTIK_ERROR_REPORTING__ENABLED=true

# --- Optional: email (recommended for recovery / admin alerts) ---
# AUTHENTIK_EMAIL__HOST=smtp.example.com
# AUTHENTIK_EMAIL__PORT=587
# AUTHENTIK_EMAIL__USERNAME=
# AUTHENTIK_EMAIL__PASSWORD=
# AUTHENTIK_EMAIL__USE_TLS=true
# AUTHENTIK_EMAIL__FROM=authentik@example.com
