# Production environment
# nginx listens on port 80
OPS_PUBLIC_IP=192.168.100.200

ENV=prod

# === BASE URL (nginx prod :8081; dev vite :5173 — both in Authentik allow-list) ===
BASE_URL=http://${OPS_PUBLIC_IP}:8081
PUBLIC_URL=http://${OPS_PUBLIC_IP}:8081

# === Secrets ===
SECRET_KEY=hrms-prod-local-secret-change-before-real-production

# === Database ===
POSTGRES_USER=hrms_user
POSTGRES_PASSWORD=hrms_pass_prod
POSTGRES_DB=hrms_prod
DATABASE_URL=postgresql+asyncpg://hrms_user:hrms_pass_prod@postgres:5432/hrms_prod

# === OnlyOffice ===
ONLYOFFICE_ENABLED=true
ONLYOFFICE_JWT_SECRET=onlyoffice-prod-secret-change-before-real-production
ONLYOFFICE_PUBLIC_URL=
ONLYOFFICE_INTERNAL_URL=http://nginx/onlyoffice

# === App ===
BACKEND_INTERNAL_CALLBACK_URL=http://backend:8000
APP_PUBLIC_URL=http://${OPS_PUBLIC_IP}:8081
TELEGRAM_PUBLIC_APP_URL=http://${OPS_PUBLIC_IP}:8081

# === LocalTunnel ===
LOCALTUNNEL_SUBDOMAIN=hrms-prod-7q2k9m4x

# === Optional: custom postgres data path ===
# === Telegram Login (bot deep-link + Widget) — token is set via /settings/users UI (system_settings.telegram.bot_token) ===
TELEGRAM_BOT_USERNAME=ktm2000_bot
TELEGRAM_ALLOW_JIT=false
TELEGRAM_DEFAULT_ROLE=admin
TELEGRAM_BOT_CHALLENGE_TTL_SECONDS=300
TELEGRAM_AUTH_DATE_MAX_AGE_SECONDS=600
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_UPDATES_POLLING=true
TELEGRAM_BOT_REPLY_ENABLED=true
# unused reserved — origin check not enforced
# Dev :5173 + prod :8081, host IP + localhost
TELEGRAM_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:8081,http://localhost:5173,http://127.0.0.1:8081,http://127.0.0.1:5173

# === App JWT (per-app — never share with KTM; SSO is Authentik only) ===
JWT_SECRET_KEY=hrms-jwt-prod-secret-change-before-real-production
# Magic Bearer "admin" only when true (must be false in prod)
DEV_BYPASS_AUTH=true
# === Emergency Break Glass Access ===
BREAK_GLASS_ENABLED=true
BREAK_GLASS_USER=emergency_admin
BREAK_GLASS_PASSWORD=dev
AUTH_OIDC_ENABLED=true
# Browser-facing issuer (LAN host IP). SPA rewrites localhost↔LAN by page host.
AUTH_OIDC_ISSUER=http://${OPS_PUBLIC_IP}:9000/application/o/hrms/
AUTH_OIDC_CLIENT_ID=hrms
AUTH_OIDC_CLIENT_SECRET=
# Hint only — SPA always uses window.location.origin (/auth/callback on :8081 or :5173)
AUTH_OIDC_REDIRECT_URI=http://${OPS_PUBLIC_IP}:8081/auth/callback
AUTH_OIDC_SCOPES=openid profile email hrms_access
# Accept id_token.iss from either host
AUTH_OIDC_ISSUER_ALIASES=localhost,127.0.0.1,host.docker.internal
# Server-side from Docker: localhost:9000 is the container itself → use host gateway.
AUTH_OIDC_TOKEN_URL=http://${OPS_PUBLIC_IP}:9000/application/o/token/
AUTH_OIDC_JWKS_URL=http://${OPS_PUBLIC_IP}:9000/application/o/hrms/jwks/
AUTH_OIDC_ALLOW_JIT=true
AUTH_OIDC_TELEGRAM_PRIMARY=false
# Phase 3: SSO-only mode (true = Authentik SSO is the only login path; direct password & invite login blocked)
AUTH_SSO_ONLY=true
AUTH_OIDC_LOGIN_HINT_ENABLED=true
AUTHENTIK_API_URL=http://${OPS_PUBLIC_IP}:9000
AUTHENTIK_PUBLIC_URL=http://${OPS_PUBLIC_IP}:9000
# AUTHENTIK_API_TOKEN= — only if token already exists; leave empty
TZ=Europe/Moscow

# === Service-to-service (idp-ops sync) ===
SERVICE_API_KEY=idp-ops-sync-2026
